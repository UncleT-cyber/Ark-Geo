# ---- Application ----
ARKGEO_DEBUG=true
ARKGEO_HOST=0.0.0.0
ARKGEO_PORT=8000

# ---- Security ----
ARKGEO_JWT_SECRET=change-me-in-production
ARKGEO_AES_KEY=please-replace-with-a-secure-32-byte-key

# ---- Storage ----
ARKGEO_STORAGE_BACKEND=local
ARKGEO_LOCAL_STORAGE_PATH=./arkgeo_data

# ---- Vision Ensemble (Tier 2) ----
# Leave blank to skip; pipeline will still run via Tier 3 extractors
ARKGEO_GEOSPY_API_KEY=
ARKGEO_GEOINFER_API_KEY=

# ---- LLM (Tier 3 clue extractors) ----
# OpenAI-compatible endpoint
ARKGEO_LLM_API_KEY=
ARKGEO_LLM_BASE_URL=https://api.openai.com/v1
ARKGEO_LLM_MODEL=gpt-4o

# Alternative vision/LLM providers (optional; used by analyze_vision_scene)
ARKGEO_GEMINI_API_KEY=
ARKGEO_ANTHROPIC_API_KEY=

# ---- Mapbox (server-side spatial reverse geocoding) ----
ARKGEO_MAPBOX_TOKEN=

# ---- Reverse source discovery ----
ARKGEO_TINEYE_API_KEY=
ARKGEO_SERPER_API_KEY=

# ---- Google Street View (panorama forensics) ----
# NOTE: Maps APIs (Geocoding + Map Tiles) reject keys unless Billing is enabled
# on the Google Cloud project — a valid key still needs billing.
ARKGEO_GOOGLE_MAPS_API_KEY=

# Keyless geocoding fallback (OpenStreetMap Nominatim) used when Google is
# unavailable/billing-off so city-level map targets still resolve.
ARKGEO_GEO_NOMINATIM_FALLBACK=true

# ---- Twilio (SOS dispatch) ----
ARKGEO_TWILIO_ACCOUNT_SID=
ARKGEO_TWILIO_AUTH_TOKEN=
ARKGEO_TWILIO_FROM_NUMBER=

# ---- Telemetry (Cell / Wi-Fi lookups) ----
ARKGEO_OPENCELLID_API_KEY=

# ---- Social availability probes (digital footprint, lab mode) ----
# Availability probes only — no account enumeration or scraping.
ARKGEO_SOCIAL_PROBE_ENABLED=true
ARKGEO_SOCIAL_PROBE_TIMEOUT=6

# ---- Dead-Man switch ----
ARKGEO_DEADMAN_POLL_SECONDS=15
ARKGEO_DEADMAN_GRACE_SECONDS=60

# ---- ARK-CAI Unified AI Core (embedded CAI engine) ----
# Bypass upstream license gate so CAI works with Ollama / cloud models.
ARKGEO_CAI_LICENSE_OFF=true
# Optional live model backend, e.g. "ollama/ark-cai" or "gpt-4o".
# Leave blank to use THE ARK deterministic offline executor.
ARKGEO_CAI_MODEL=
ARKGEO_CAI_BASE_URL=
