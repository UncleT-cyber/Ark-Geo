{
  "name": "arkgeo-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "THE ARK — Integrated Security Environment",
  "main": "main.js",
  "author": "ArkGeo",
  "scripts": {
    "dev": "cd ../arkgeo-investigator-web && npx vite & npx wait-on http://localhost:12001 && cd ../arkgeo-desktop && npx electron .",
    "build:frontend": "cd ../arkgeo-investigator-web && npx vite build",
    "build:mac": "npm run build:frontend && electron-builder --mac",
    "build:win": "npm run build:frontend && electron-builder --win",
    "build:linux": "npm run build:frontend && electron-builder --linux",
    "build:all": "npm run build:frontend && electron-builder -mwl",
    "start": "electron ."
  },
  "dependencies": {
    "electron-store": "^8.2.0"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.arkgeo.ark-ise",
    "productName": "THE ARK",
    "copyright": "Copyright © 2026 ArkGeo",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../arkgeo-investigator-web/dist",
        "to": "app"
      },
      {
        "from": "../arkgeo-backend",
        "to": "arkgeo-backend",
        "filter": [
          "**/*.py",
          "**/*.env",
          "requirements.txt",
          "app/**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "sign": false,
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icons",
      "category": "Utility"
    }
  }
}
